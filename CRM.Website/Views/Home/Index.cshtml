@using CRM.Resources
@using Fanex.NAP.Client.Configuration
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject INapSettings napSettings
@{ ViewData["Title"] = ViewResources.CRMSystem; }
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/main.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/main.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/js/dev/pages/home/index.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/auth/recheckin.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script asp-src-include="~/js/pro/pages/home/index.*.chunk.js" asp-append-version="true"></script>
        <script asp-src-include="~/js/pro/pages/auth/recheckin.*.chunk.js" asp-append-version="true"></script>
    </environment>
}
<input type="checkbox" hidden id="isEnableReCheckIn" @(napSettings.EnableReCheckIn ? "checked" : string.Empty) />
<div id="app-container"></div>
<input type="checkbox" hidden id="hasCreateFeedbackPermission" @(Model ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasReadFeedbackPermission" @(ViewBag.hasReadFeedbackPermission ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasReadCustomerInfo" @(ViewBag.hasReadCustomerInfo ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasReadSitePermission" @(ViewBag.hasReadSitePermission ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasReadLicenseePermission" @(ViewBag.hasReadLicenseePermission ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasReadCreditPermission" @(ViewBag.hasReadCreditPermission ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasHostPicManagementPermission" @(ViewBag.hasHostPicManagementPermission ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasHeadlineInfoPermission" @(ViewBag.hasHeadlineInfoPermission ? "checked" : string.Empty) />
