@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/www/dist/css/build/main.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/www/dist/css/build/main.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/www/dist/js/build/pages/home/index.chunk.js"></script>
        <script src="~/www/dist/js/build/lib/lang-en-US.chunk.js"></script>
        <script src="~/www/dist/js/build/lib/vendor.chunk.js"></script>
        <script src="~/www/dist/js/build/lib/common.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/www/dist/js/build/pages/home/index.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/build/lib/lang-en-US.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/build/lib/vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/build/pages/common.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>
<div hidden id="xsrfToken"></div>
<div hidden id="currentUsername"></div>
<div hidden id="currentCustId"></div>
<div hidden id="currentClientTime"></div>
<div hidden id="clientTimezone"></div>
<div hidden id="serverTimezone"></div>
<input hidden type="checkbox" id="hasCreateFeedbackPermission" />