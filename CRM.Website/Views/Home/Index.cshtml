@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/www/dist/css/dev/main.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/www/dist/css/pro/main.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/www/dist/js/dev/pages/home/index.chunk.js"></script>
        <script src="~/www/dist/js/dev/lib/lang-en-US.chunk.js"></script>
        <script src="~/www/dist/js/dev/lib/vendor.chunk.js"></script>
        <script src="~/www/dist/js/dev/lib/common.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/www/dist/js/pro/pages/home/index.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/pro/lib/lang-en-US.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/pro/lib/vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/pro/pages/common.chunk.js" asp-append-version="true"></script>
    </environment>
}
<input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
<div hidden id="root-url"></div>
<div id="app-container"></div>
<div hidden id="xsrfToken"></div>
<div hidden id="currentUsername"></div>
<div hidden id="currentCustId"></div>
<div hidden id="currentClientTime"></div>
<div hidden id="clientTimezone"></div>
<div hidden id="serverTimezone"></div>
<input hidden type="checkbox" id="hasCreateFeedbackPermission" />