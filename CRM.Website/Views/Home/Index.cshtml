@using Fanex.NAP.Client.Configuration
@inject INapSettings napSettings
@{ ViewData["Title"] = ViewResources.CRMSystem; }
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/www/dist/css/dev/main.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/www/dist/css/pro/main.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/www/dist/js/dev/pages/home/index.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/dev/pages/auth/recheckin.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/www/dist/js/pro/pages/home/index.chunk.js" asp-append-version="true"></script>
        <script src="~/www/dist/js/pro/pages/auth/recheckin.chunk.js" asp-append-version="true"></script>
    </environment>
}
<input type="checkbox" hidden id="isEnableReCheckIn" @(napSettings.EnableReCheckIn ? "checked" : string.Empty) />
<div id="app-container"></div>
<input type="checkbox" hidden id="hasCreateFeedbackPermission" @(Model ? "checked" : string.Empty) />
<input type="checkbox" hidden id="hasReadFeedbackPermission" @(ViewBag.hasReadFeedbackPermission ? "checked" : string.Empty) />