@model CRM.Models.Customer.GetPermissionCustomer
@{
    ViewData["Title"] = ViewResources.CustomerInfoDetail;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/customer/customerinfodetail/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/customer/customerinfodetail/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <script type="text/javascript">
            window.customerInfoPolicy = @(Model.CustomerInfoPolicy);
            window.updateHeadlineInfoPolicy = @(Model.UpdateHeadlineInfoPolicy);
    </script>
    <environment include="Development">
        <script src="~/js/dev/pages/customer/customerinfodetail/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/customer/customerinfodetail/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>