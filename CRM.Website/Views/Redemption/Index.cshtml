@model CRM.Models.Customer.GetPermissionCustomer
@{
    ViewData["Title"] = ViewResources.Redemption;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/redemption/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/redemption/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <script type="text/javascript">
        window.customerInfoPolicy = @(Model.CustomerInfoPolicy);
        window.createUpdateFeedbackPermission = @(Model.CreateUpdateFeedbackPermission);
    </script>
    <environment include="Development">
        <script src="~/js/dev/pages/redemption/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/redemption/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>