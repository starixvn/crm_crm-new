@model CRM.ViewModels.Customer.CustomerPermissionViewModel
@{
    ViewData["Title"] = ViewResources.ChangesLog;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/picandheadline/changeslog/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/picandheadline/changeslog/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/js/dev/pages/picandheadline/changeslog/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/picandheadline/changeslog/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>