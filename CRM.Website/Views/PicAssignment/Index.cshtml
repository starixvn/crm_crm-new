@model bool
@{
    ViewData["Title"] = ViewResources.PICAssignment;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/picandheadline/picassignment/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/picandheadline/picassignment/index.chunk.css" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/js/dev/pages/picandheadline/picassignment/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/picandheadline/picassignment/index.chunk.js"></script>
    </environment>
}
<input type="checkbox" hidden id="is-host" @(Model ? "checked" : string.Empty) />
<div id="app-container"></div>