@using CRM.Models;
@model BaseModel
@{
    ViewData["Title"] = ViewResources.AddCustomerFeedback;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/feedback/add-customer-feedback/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/feedback/add-customer-feedback/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <environment include="Development">
        <script src="~/js/dev/pages/feedback/add-customer-feedback/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/feedback/add-customer-feedback/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>
<input type="hidden" id="custId" name="custId" value="@Model.Id" />
