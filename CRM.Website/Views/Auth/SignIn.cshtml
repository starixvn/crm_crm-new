<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta charset="utf-8" />
    <title>Sign In</title>
    <meta name="viewport" content="width=device-width" />
</head>
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/www/dist/css/dev/pages/auth/login.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/www/dist/css/dev/pages/auth/login.chunk.css" asp-append-version="true" />
    </environment>
}
<body>
    <div id='not-supported-browser-panel' style="display: none">
        Your browser is no longer supported. Some parts will not work and you may experience
        problems.<br />
        If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
        browsing experience. Thank you!
    </div>

    <div class="center">
        <div id="login-box">
            @if (!string.IsNullOrWhiteSpace(ViewBag.Message))
            {
                <div id="msg">
                    <span id="inner-msg">@ViewBag.Message</span>
                </div>
            }
            <div class="header">
                <div class="welcome">
                </div>
                <div class="secure">
                </div>
            </div>
            <div class="auth">
                <form action="@Url.Content("~/Auth/SignIn")" method="POST" id="frmLogin" name="frmLogin">
                    @Html.AntiForgeryToken()
                    <input id="loginToken" name="loginToken" value="@ViewBag.LoginToken" type="hidden" />
                    <input type="text" id="username" name="username" autocomplete="off" required />
                    <input type="password" id="password" name="password" required />
                    <input type="submit" id="btnLogin" value="Sign in" />

                    <div class="bestview">
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/www/dist/lib/CryptoJS.js"></script>
    <script>
        const form = document.getElementById('frmLogin');
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var password = document.getElementById('password').value;
            var encryptedPassword = CryptoJS.CfsEnCode(password);
            document.getElementById('password').value = encryptedPassword;
            form.submit();
        });
    </script>
</body>
</html>