@model CRM.Models.InformHeadline.GetPermissionInform
@{
    ViewData["Title"] = ViewResources.InformHeadline;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/informheadline/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="/css/pro/pages/informHeadline/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <script type="text/javascript">
        window.contactPolicy = @(Model.ContactPolicy);
        window.searchPolicy = @(Model.SearchPolicy);
        window.hasHostPermission = @Json.Serialize(Model.HasHostPermission);
    </script>
    <environment include="Development">
        <script src="~/js/dev/pages/informheadline/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="/js/pro/pages/informheadline/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>