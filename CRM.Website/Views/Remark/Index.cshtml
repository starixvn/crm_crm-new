@model CRM.ViewModels.Customer.CustomerPermissionViewModel
@{
    ViewData["Title"] = ViewResources.SpecialRemark;
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/remark/index.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/remark/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <script type="text/javascript">
        window.customerInfoPolicy = @(Model.CustomerInfoPolicy);
    </script>
    <environment include="Development">
        <script src="~/js/dev/pages/remark/index.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/remark/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>
<input type="hidden" id="id" name="custId" value="@Model.Id" />