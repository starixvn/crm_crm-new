  <ItemGroup>
    <None Remove="App_Data\Development\SpNames.xml" />
    <None Remove="App_Data\Local\SpNames.xml" />
    <None Remove="App_Data\Production\SpNames.xml" />
    <None Remove="App_Data\SIT\SpNames.xml" />
    <None Remove="App_Data\UAT\SpNames.xml" />
